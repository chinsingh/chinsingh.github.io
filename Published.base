views:
  - type: table
    name: Table
    filters:
      and:
        - file.path.startsWith("posts")
        - file.ext.endsWith("md")
        - draft != true
    order:
      - title
      - file.name
      - display_date
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.title: 636
